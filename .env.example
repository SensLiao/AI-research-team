# Research Agent Teams — server-access env TEMPLATE (placeholders; commit THIS, never the real .env).
#
# When the director provides lab-server access (via the out-of-repo handoff file
#   <local-workspace>\.tmp\server-access-handoff.md ),
# copy this file to  research_agent_teams/.env  and fill in REAL values there.
# .env is gitignored and is read by the operate layer from environment variables only.
# HARD RULE: real credentials NEVER go in the repo, in git, in chat, or in logs.
#
# Until .env exists + is wired, all GPU-execution flows stay gated; the no-GPU flows
# (ingest / recall / find-a-direction / design / venue-readiness / promote) run without these.

# --- lab GPU server (SSH) ---
RAT_SERVER_HOST=your.lab.server.example.edu
# Optional literal IP for environments where local DNS is intercepted/overridden. TCP connects to this
# endpoint, while RAT_SERVER_HOST remains the canonical identity used for pinned host-key verification.
# Never replace RAT_SERVER_HOST with the IP and never use AutoAddPolicy.
RAT_SERVER_CONNECT_HOST=
RAT_SERVER_PORT=22
RAT_SERVER_USER=your_username
# Prefer key auth. Point at a key file OUTSIDE the repo (e.g. C:\Users\<you>\.ssh\id_ed25519).
RAT_SERVER_SSH_KEY=C:\path\to\private_key_outside_repo
# Only if the server requires password auth (key strongly preferred):
RAT_SERVER_PASSWORD=
# SSH host-key verification (⑥ MITM defense). The connection is NEVER trust-on-first-use: an unknown
# host is REJECTED. Pin the server's key out-of-band and point this at the file, e.g.:
#   ssh-keyscan -p 22 your.lab.server.example.edu >> C:\path\to\known_hosts_outside_repo
# then verify the printed fingerprint with the lab before trusting it. Blank => system known_hosts only.
RAT_SERVER_KNOWN_HOSTS=

# --- remote workspace + runtime ---
RAT_REMOTE_WORKDIR=/home/your_username/research-runs
RAT_REMOTE_PYTHON=python3
RAT_REMOTE_CONDA_ENV=
# Job scheduler if any (e.g. "slurm" -> uses sbatch; blank -> plain nohup/ssh):
RAT_SCHEDULER=
RAT_GPU_PARTITION=

# --- where finished run artifacts are pulled back to (inside the gitignored run-store) ---
RAT_RESULTS_PULL_DIR=runs

# --- secondary USyd BDAV Z390-3090 server (SSH; independently resolved resource) ---
RAT_BDAV_Z390_HOST=your.secondary.lab.server.example.edu
RAT_BDAV_Z390_CONNECT_HOST=
RAT_BDAV_Z390_PORT=22
RAT_BDAV_Z390_USER=your_username
RAT_BDAV_Z390_SSH_KEY=
RAT_BDAV_Z390_PASSWORD=
RAT_BDAV_Z390_KNOWN_HOSTS=
RAT_BDAV_Z390_REMOTE_WORKDIR=/mnt/HDD4
RAT_BDAV_Z390_REMOTE_PYTHON=python3
RAT_BDAV_Z390_REMOTE_CONDA_ENV=
RAT_BDAV_Z390_REMOTE_CONDA_SH=
RAT_BDAV_Z390_SCHEDULER=
RAT_BDAV_Z390_RESULTS_PULL_DIR=runs

# --- optional: python the hooks shell out to (defaults to "python") ---
RAT_PYTHON=python

# --- scholarly APIs (live retrieval / citation-existence checks) ---
# Optional Semantic Scholar API key (raises the free-tier quota; scholar_clients sends it as
# the x-api-key header when set). All sources still degrade honestly when offline/unset.
RAT_S2_API_KEY=
