{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/research_perspective_note.schema.json",
  "title": "Research Perspective Note",
  "description": "One independent perspective worker's compressed contribution to a deep_research run. It is a research memo slice, not raw notes.",
  "type": "object",
  "required": ["perspective_id", "angle", "questions", "finding_summary", "source_refs", "coverage_limits", "actionable_opportunities"],
  "additionalProperties": false,
  "properties": {
    "perspective_id": {"type": "string", "minLength": 1, "pattern": "^P[0-9]+$"},
    "angle": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "finding_summary": {"type": "string", "minLength": 80, "maxLength": 2400},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coverage_limits": {"type": "array", "items": {"type": "string"}, "default": []},
    "actionable_opportunities": {"type": "array", "items": {"type": "string"}, "default": []},
    "kill_criteria": {"type": "array", "items": {"type": "string"}, "default": []},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"], "default": "medium"}
  }
}
