{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/provider_call_receipt.schema.json",
  "title": "Provider-observed model call receipt",
  "description": "A host-adapter-signed receipt for one provider call. Requested settings are configuration facts; observed values must come from provider response metadata, except elapsed_ms which must be captured by the host monotonic clock. Reasoning workers cannot mint this receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "producer_kind",
    "run_id",
    "task_id",
    "stage",
    "worker_id",
    "invocation_id",
    "nonce",
    "dispatch_spec_sha256",
    "provider_request_id",
    "requested",
    "observed",
    "started_at",
    "finished_at",
    "artifact",
    "attestation"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "providerStringObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"const": "provider_response"}
      }
    },
    "providerIntegerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "source": {"const": "provider_response"}
      }
    }
  },
  "properties": {
    "receipt_version": {"const": "provider-call-receipt/v1"},
    "producer_kind": {"const": "provider-host-adapter"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stage": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "worker_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "invocation_id": {"type": "string", "pattern": "^pcall-[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$"},
    "dispatch_spec_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_policy_id",
        "model",
        "service_tier",
        "reasoning_effort",
        "agent_type",
        "context_budget_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "runtime_policy_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "service_tier": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "agent_type": {"type": "string", "minLength": 1},
        "context_budget_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_model",
        "service_tier",
        "reasoning_effort",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "elapsed_ms"
      ],
      "properties": {
        "resolved_model": {"$ref": "#/$defs/providerStringObservation"},
        "service_tier": {"$ref": "#/$defs/providerStringObservation"},
        "reasoning_effort": {"$ref": "#/$defs/providerStringObservation"},
        "input_tokens": {"$ref": "#/$defs/providerIntegerObservation"},
        "output_tokens": {"$ref": "#/$defs/providerIntegerObservation"},
        "total_tokens": {"$ref": "#/$defs/providerIntegerObservation"},
        "elapsed_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source"],
          "properties": {
            "value": {"type": "integer", "minimum": 0},
            "source": {"const": "host_monotonic"}
          }
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "key_id", "signature"],
      "properties": {
        "scheme": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
