{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/manuscript_review_verdict.schema.json",
  "title": "Manuscript Review Verdict",
  "description": "Independent reviewer verdict bound to frozen contract, manuscript, PDF, and scheduler-authorized blind inputs.",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "review_run_id",
    "reviewer_identity",
    "blind_read_receipt",
    "frozen_inputs",
    "scoped_inputs",
    "findings",
    "disposition",
    "verdict_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_id": {
      "$ref": "#/$defs/nonempty"
    },
    "review_run_id": {
      "$ref": "#/$defs/nonempty"
    },
    "reviewer_identity": {
      "$ref": "#/$defs/reviewer_identity"
    },
    "blind_read_receipt": {
      "$ref": "#/$defs/blind_read_receipt"
    },
    "frozen_inputs": {
      "$ref": "#/$defs/frozen_inputs"
    },
    "scoped_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/scoped_input"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "CONTRACT"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "MANUSCRIPT"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "PDF"
              }
            }
          }
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_finding"
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "PASS",
        "NEEDS_REPAIR",
        "BLOCK"
      ]
    },
    "verdict_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/open_blocking_finding"
            }
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "BLOCK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "BLOCK"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/open_blocking_finding"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/open_repair_finding"
                }
              },
              {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/open_blocking_finding"
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "NEEDS_REPAIR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "NEEDS_REPAIR"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/open_repair_finding"
                }
              },
              {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/open_blocking_finding"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "$ref": "#/$defs/open_finding"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "$ref": "#/$defs/open_finding"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonempty": {
      "type": "string",
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000-\\u001f]+$"
    },
    "reviewer_identity": {
      "type": "object",
      "required": [
        "reviewer_id",
        "role",
        "independent_from_authoring"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/nonempty"
        },
        "role": {
          "type": "string",
          "enum": [
            "SCIENTIFIC",
            "EXACT_CITATION",
            "NUMERIC_RESULT",
            "LATEX_ASSET",
            "ANONYMITY_PRIVACY",
            "VENUE"
          ]
        },
        "independent_from_authoring": {
          "const": true
        }
      }
    },
    "blind_read_receipt": {
      "type": "object",
      "required": [
        "scheduler_authorization_ref",
        "scheduler_authorization_sha256",
        "blind_scope_sha256",
        "issued_at",
        "other_reviewer_conclusions_visible",
        "generation_artifacts_counted_as_independent_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "scheduler_authorization_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "scheduler_authorization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "blind_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issued_at": {
          "$ref": "#/$defs/nonempty"
        },
        "other_reviewer_conclusions_visible": {
          "const": false
        },
        "generation_artifacts_counted_as_independent_evidence": {
          "const": false
        }
      }
    },
    "frozen_inputs": {
      "type": "object",
      "required": [
        "contract_ref",
        "contract_sha256",
        "manuscript_ref",
        "manuscript_sha256",
        "pdf_ref",
        "pdf_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manuscript_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "manuscript_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pdf_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "pdf_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scoped_input": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "sha256",
        "authorization_receipt_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CONTRACT",
            "MANUSCRIPT",
            "PDF",
            "EVIDENCE_SLICE",
            "RESULT_SLICE",
            "VENUE_RULES",
            "ASSET_MANIFEST",
            "BUILD_RECEIPT"
          ]
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authorization_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "review_finding": {
      "type": "object",
      "required": [
        "finding_id",
        "severity",
        "status",
        "dimension",
        "locus",
        "description",
        "evidence_refs",
        "required_fix"
      ],
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/nonempty"
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKING",
            "MAJOR",
            "ADVISORY"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "dimension": {
          "type": "string",
          "enum": [
            "SCIENTIFIC",
            "CLAIM_EVIDENCE",
            "CITATION",
            "NUMERIC_RESULT",
            "EXECUTION_TRUTH",
            "LATEX_BUILD",
            "ASSET_PROVENANCE",
            "ANONYMITY_PRIVACY",
            "VENUE_COMPLIANCE"
          ]
        },
        "locus": {
          "$ref": "#/$defs/nonempty"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "required_fix": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "open_blocking_finding": {
      "type": "object",
      "required": [
        "severity",
        "status"
      ],
      "properties": {
        "severity": {
          "const": "BLOCKING"
        },
        "status": {
          "const": "OPEN"
        }
      }
    },
    "open_advisory_finding": {
      "type": "object",
      "required": [
        "severity",
        "status"
      ],
      "properties": {
        "severity": {
          "const": "ADVISORY"
        },
        "status": {
          "const": "OPEN"
        }
      }
    },
    "open_repair_finding": {
      "type": "object",
      "required": [
        "severity",
        "status"
      ],
      "properties": {
        "severity": {
          "enum": ["MAJOR", "ADVISORY"]
        },
        "status": {
          "const": "OPEN"
        }
      }
    },
    "open_finding": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "const": "OPEN"
        }
      }
    }
  }
}
