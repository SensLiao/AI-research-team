{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/gap_prosecution.schema.json",
  "title": "Gap Prosecution",
  "type": "object",
  "required": ["prosecutions"],
  "additionalProperties": false,
  "properties": {
    "prosecutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gap_id", "search_query", "closure_status", "why_status",
          "strongest_prior_art", "positive_open_evidence", "closure_evidence",
          "strongest_counterevidence", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "search_query": {"type": "string", "minLength": 1},
          "closure_status": {"type": "string", "enum": ["OPEN", "CLOSED", "UNVERIFIED"]},
          "why_status": {"type": "string", "minLength": 1},
          "strongest_prior_art": {"type": "array", "items": {"type": "object"}},
          "positive_open_evidence": {"type": "array", "items": {"type": "object"}},
          "closure_evidence": {"type": "array", "items": {"type": "object"}},
          "strongest_counterevidence": {"type": "string"},
          "evidence_ref": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
