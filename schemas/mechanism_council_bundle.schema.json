{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/mechanism_council_bundle.schema.json",
  "title": "Mechanism Council Compiled Bundle",
  "type": "object",
  "required": [
    "contract_version",
    "work_order",
    "contribution_receipts",
    "compiled_chain",
    "conflicts",
    "truth_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "mechanism-council-bundle/v1"},
    "work_order": {
      "type": "object",
      "required": ["request_id", "north_star", "input_sha256"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "north_star": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "contribution_receipts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["role", "sha256"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "compiled_chain": {
      "type": "object",
      "required": ["hypothesis", "mechanism", "falsifiable_experiment"],
      "additionalProperties": false,
      "properties": {
        "hypothesis": {
          "type": "object",
          "required": ["statement", "alternative", "observable_prediction"],
          "additionalProperties": false,
          "properties": {
            "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "alternative": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "observable_prediction": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "mechanism": {
          "type": "object",
          "required": ["inputs", "representation", "transformation", "output", "distinguishing_signal", "failure_modes"],
          "additionalProperties": false,
          "properties": {
            "inputs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "representation": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "transformation": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "output": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "distinguishing_signal": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "falsifiable_experiment": {
          "type": "object",
          "required": ["intervention", "comparator", "held_constant", "analysis_unit", "primary_outcome", "leakage_checks", "falsifier", "stop_condition"],
          "additionalProperties": false,
          "properties": {
            "intervention": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "comparator": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "held_constant": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "analysis_unit": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "primary_outcome": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "leakage_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "falsifier": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "stop_condition": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "roles", "summary", "resolution_status"],
        "additionalProperties": false,
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "resolution_status": {"enum": ["RESOLVED", "OPEN"]},
          "resolution": {"type": "string"}
        }
      }
    },
    "truth_boundary": {
      "type": "object",
      "required": ["execution_status", "result_claims_allowed", "novelty_claim_allowed", "compiler_agent_id"],
      "additionalProperties": false,
      "properties": {
        "execution_status": {"const": "DESIGN_ONLY"},
        "result_claims_allowed": {"const": false},
        "novelty_claim_allowed": {"const": false},
        "compiler_agent_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

