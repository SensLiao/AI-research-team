{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/dataset_card.schema.json",
  "title": "Dataset Card",
  "description": "DISCOVER-stage typed artifact. Output of dataset-card-builder. Structured description of a dataset including provenance, splits, known overlaps, and leakage risks. The leakage_risks field must be present (may be empty only if no risks are detected); a card with a known overlap that does not list a risk is a quality failure.",
  "type": "object",
  "required": ["dataset_ref", "description", "splits", "leakage_risks"],
  "additionalProperties": false,
  "properties": {
    "dataset_ref": {"type": "string", "minLength": 1, "description": "canonical ref (URL, DOI, or internal id)"},
    "description": {"type": "string", "minLength": 1},
    "year": {"type": ["integer", "null"], "default": null},
    "license": {"type": ["string", "null"], "default": null},
    "modality": {"type": ["string", "null"], "default": null},
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_samples": {"type": ["integer", "null"], "default": null},
        "unit": {"type": ["string", "null"], "default": null}
      },
      "default": {}
    },
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "n_samples"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "enum": ["train", "val", "test", "full", "other"]},
          "n_samples": {"type": ["integer", "null"], "minimum": 0, "default": null},
          "split_unit": {"type": ["string", "null"], "default": null}
        }
      }
    },
    "known_overlaps": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "names of other datasets known to share samples with this one"
    },
    "leakage_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "description", "severity"],
        "additionalProperties": false,
        "properties": {
          "risk_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "overlapping_dataset": {"type": ["string", "null"], "default": null}
        }
      },
      "description": "list of known or suspected leakage risks; non-empty when known_overlaps is non-empty"
    },
    "provenance_notes": {"type": "string", "default": ""}
  }
}
