{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/manuscript_quality_report.schema.json",
  "title": "Manuscript Quality Report",
  "description": "Deterministic hard/advisory findings with separate daily-usability and submission-readiness outputs.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "manuscript_sha256",
    "requires_pdf",
    "build",
    "findings",
    "daily_state",
    "daily_rationale",
    "submission_ready",
    "submission_blockers",
    "quality_report_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "#/$defs/nonempty"
    },
    "manuscript_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requires_pdf": {
      "type": "boolean"
    },
    "build": {
      "$ref": "#/$defs/build_summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "daily_state": {
      "type": "string",
      "enum": [
        "USABLE",
        "USABLE_WITH_CAVEATS",
        "NEEDS_SUPPLEMENT",
        "BLOCK"
      ]
    },
    "daily_rationale": {
      "$ref": "#/$defs/nonempty"
    },
    "submission_ready": {
      "type": "boolean"
    },
    "submission_blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/submission_blocker"
      }
    },
    "quality_report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/open_daily_block"
            }
          }
        }
      },
      "then": {
        "properties": {
          "daily_state": {
            "const": "BLOCK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "daily_state": {
            "const": "BLOCK"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/open_daily_block"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/open_daily_supplement"
                }
              },
              {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/open_daily_block"
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "daily_state": {
            "const": "NEEDS_SUPPLEMENT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/open_daily_caveat"
                }
              },
              {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/open_daily_supplement"
                  }
                }
              },
              {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/open_daily_block"
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "daily_state": {
            "const": "USABLE_WITH_CAVEATS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "$ref": "#/$defs/open_daily_effect"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "daily_state": {
            "const": "USABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/open_submission_block"
            }
          }
        }
      },
      "then": {
        "properties": {
          "submission_ready": {
            "const": false
          },
          "submission_blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "submission_ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "$ref": "#/$defs/open_submission_block"
              }
            }
          },
          "submission_blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "submission_ready": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "submission_blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "requires_pdf",
          "build"
        ],
        "properties": {
          "requires_pdf": {
            "const": true
          },
          "build": {
            "required": ["state"],
            "properties": {
              "state": {
                "enum": [
                  "TOOLCHAIN_MISSING",
                  "COMPILE_FAILED"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "type": "object",
              "required": [
                "finding_class",
                "scope",
                "status",
                "daily_effect",
                "submission_effect",
                "code"
              ],
              "properties": {
                "finding_class": {
                  "const": "HARD"
                },
                "scope": {
                  "const": "SUBMISSION"
                },
                "status": {
                  "const": "OPEN"
                },
                "daily_effect": {
                  "const": "NONE"
                },
                "submission_effect": {
                  "const": "BLOCK"
                },
                "code": {
                  "const": "BUILD_REQUIRED_UNAVAILABLE"
                }
              }
            }
          },
          "submission_ready": {
            "const": false
          },
          "submission_blockers": {
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": {
                  "const": "BUILD_REQUIRED_UNAVAILABLE"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonempty": {
      "type": "string",
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000-\\u001f]+$"
    },
    "build_summary": {
      "type": "object",
      "required": [
        "receipt_ref",
        "receipt_sha256",
        "state",
        "source_sha256",
        "pdf_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "receipt_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "state": {
          "type": "string",
          "enum": [
            "COMPILED",
            "TOOLCHAIN_MISSING",
            "COMPILE_FAILED"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pdf_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": {
              "state": {
                "const": "COMPILED"
              }
            }
          },
          "then": {
            "properties": {
              "pdf_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "pdf_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "finding_class",
        "scope",
        "status",
        "daily_effect",
        "submission_effect",
        "code",
        "message",
        "evidence_refs",
        "repair"
      ],
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/nonempty"
        },
        "finding_class": {
          "type": "string",
          "enum": [
            "HARD",
            "ADVISORY"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "DAILY_USE",
            "SUBMISSION",
            "BOTH"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "daily_effect": {
          "type": "string",
          "enum": [
            "NONE",
            "CAVEAT",
            "SUPPLEMENT",
            "BLOCK"
          ]
        },
        "submission_effect": {
          "type": "string",
          "enum": [
            "NONE",
            "BLOCK"
          ]
        },
        "code": {
          "$ref": "#/$defs/nonempty"
        },
        "message": {
          "$ref": "#/$defs/nonempty"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "repair": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "daily_effect": {
                "const": "NONE"
              },
              "submission_effect": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "finding_class",
              "status"
            ],
            "properties": {
              "finding_class": {
                "const": "ADVISORY"
              },
              "status": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "daily_effect": {
                "enum": [
                  "NONE",
                  "CAVEAT",
                  "SUPPLEMENT"
                ]
              },
              "submission_effect": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "finding_class",
              "scope",
              "status"
            ],
            "properties": {
              "finding_class": {
                "const": "HARD"
              },
              "scope": {
                "const": "DAILY_USE"
              },
              "status": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "daily_effect": {
                "const": "BLOCK"
              },
              "submission_effect": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "finding_class",
              "scope",
              "status"
            ],
            "properties": {
              "finding_class": {
                "const": "HARD"
              },
              "scope": {
                "const": "SUBMISSION"
              },
              "status": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "daily_effect": {
                "const": "NONE"
              },
              "submission_effect": {
                "const": "BLOCK"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "finding_class",
              "scope",
              "status"
            ],
            "properties": {
              "finding_class": {
                "const": "HARD"
              },
              "scope": {
                "const": "BOTH"
              },
              "status": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "daily_effect": {
                "const": "BLOCK"
              },
              "submission_effect": {
                "const": "BLOCK"
              }
            }
          }
        }
      ]
    },
    "submission_blocker": {
      "type": "object",
      "required": [
        "blocker_id",
        "code",
        "source_ref",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "blocker_id": {
          "$ref": "#/$defs/nonempty"
        },
        "code": {
          "$ref": "#/$defs/nonempty"
        },
        "source_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "open_daily_block": {
      "type": "object",
      "required": [
        "finding_class",
        "status",
        "daily_effect"
      ],
      "properties": {
        "finding_class": {
          "const": "HARD"
        },
        "status": {
          "const": "OPEN"
        },
        "daily_effect": {
          "const": "BLOCK"
        }
      }
    },
    "open_daily_supplement": {
      "type": "object",
      "required": [
        "status",
        "daily_effect"
      ],
      "properties": {
        "status": {
          "const": "OPEN"
        },
        "daily_effect": {
          "const": "SUPPLEMENT"
        }
      }
    },
    "open_daily_caveat": {
      "type": "object",
      "required": [
        "status",
        "daily_effect"
      ],
      "properties": {
        "status": {
          "const": "OPEN"
        },
        "daily_effect": {
          "const": "CAVEAT"
        }
      }
    },
    "open_daily_effect": {
      "type": "object",
      "required": [
        "status",
        "daily_effect"
      ],
      "properties": {
        "status": {
          "const": "OPEN"
        },
        "daily_effect": {
          "enum": [
            "CAVEAT",
            "SUPPLEMENT",
            "BLOCK"
          ]
        }
      }
    },
    "open_submission_block": {
      "type": "object",
      "required": [
        "finding_class",
        "status",
        "submission_effect"
      ],
      "properties": {
        "finding_class": {
          "const": "HARD"
        },
        "status": {
          "const": "OPEN"
        },
        "submission_effect": {
          "const": "BLOCK"
        }
      }
    }
  }
}
