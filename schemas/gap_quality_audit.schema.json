{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/gap_quality_audit.schema.json",
  "title": "Gap Quality Audit",
  "type": "object",
  "required": ["audits"],
  "additionalProperties": false,
  "properties": {
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "verdict", "dimensions", "strongest_objection",
          "required_repairs", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["PASS", "REVISE", "BLOCK"]},
          "dimensions": {"type": "object"},
          "strongest_objection": {"type": "string", "minLength": 1},
          "required_repairs": {"type": "array", "items": {"type": "string"}},
          "evidence_ref": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
