{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/research_markdown_brief.schema.json",
  "title": "Research Markdown Brief",
  "description": "Machine evidence that a human-readable deep_research Markdown brief was produced under director-review/research/.",
  "type": "object",
  "required": ["topic", "markdown", "evidence_refs", "perspective_ids"],
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "markdown": {"type": "string", "minLength": 700},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "perspective_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "quality_caveats": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
