{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-teams.local/schemas/overlay_ab_judge_sheet.schema.json",
  "title": "Research capability overlay Stage-B blind judge sheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "judge_id",
    "judge_role",
    "packet_sha256",
    "blindness_attestation",
    "cases",
    "overall_notes"
  ],
  "properties": {
    "schema_version": {"const": "research-capability-overlay-judge-sheet/v1"},
    "rubric_version": {"const": "research-capability-overlay-stage-b-rubric/v1"},
    "judge_id": {"type": "string", "minLength": 1},
    "judge_role": {
      "enum": ["domain_mechanism", "methods_statistics", "evidence_integrity"]
    },
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blindness_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_mapping_not_seen",
        "other_judge_sheets_not_seen",
        "author_runtime_receipts_not_seen"
      ],
      "properties": {
        "condition_mapping_not_seen": {"const": true},
        "other_judge_sheets_not_seen": {"const": true},
        "author_runtime_receipts_not_seen": {"const": true}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/case"}
    },
    "overall_notes": {"type": "string"}
  },
  "$defs": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8"],
      "properties": {
        "Q1": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q2": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q3": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q4": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q5": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q6": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q7": {"type": "integer", "minimum": 0, "maximum": 4},
        "Q8": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "fatal_defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "summary", "evidence_locator"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"const": "FATAL"},
        "summary": {"type": "string", "minLength": 1},
        "evidence_locator": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "fatal_defects", "rationale"],
      "properties": {
        "scores": {"$ref": "#/$defs/scores"},
        "fatal_defects": {
          "type": "array",
          "items": {"$ref": "#/$defs/fatal_defect"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "candidates", "winner", "winner_rationale"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^HB-[0-9]{2}$"},
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["X", "Y"],
          "properties": {
            "X": {"$ref": "#/$defs/candidate"},
            "Y": {"$ref": "#/$defs/candidate"}
          }
        },
        "winner": {"enum": ["X", "Y", "TIE"]},
        "winner_rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
