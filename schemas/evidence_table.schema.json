{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/evidence_table.schema.json",
  "title": "Evidence Table",
  "description": "DISCOVER-stage source register. Legacy tables carry a self-reported saturation flag. Current evidence-table/v2 tables bind a methodology report and semantic search trace; the flag is then only a compatibility mirror and is never trusted by strict-current helpers.",
  "type": "object",
  "required": ["query", "sources", "saturation_reached"],
  "additionalProperties": false,
  "properties": {
    "evidence_contract_version": {
      "type": "string",
      "enum": ["evidence-table/v2", "LEGACY_UNVERIFIED"]
    },
    "source_quality_report_ref": {"type": "string", "minLength": 1},
    "search_trace_ref": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "kind": {"type": "string", "enum": ["paper", "repo", "dataset", "benchmark", "blog", "doc"]},
          "year": {"type": ["integer", "null"], "default": null},
          "ref": {"type": "string", "minLength": 1, "description": "[[slug]]+sha, DOI, arXiv id, or URL — a resolvable reference, never inlined content"},
          "claim_support": {"type": "string", "enum": ["strong", "moderate", "weak", "none"], "default": "none"},
          "notes": {"type": "string"}
        }
      }
    },
    "saturation_reached": {"type": "boolean", "description": "Legacy compatibility mirror. Current completion is recomputed from evidence_search_trace/v1."},
    "n_sources": {"type": ["integer", "null"], "minimum": 0, "default": null}
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_contract_version": {"const": "evidence-table/v2"}},
        "required": ["evidence_contract_version"]
      },
      "then": {
        "required": ["source_quality_report_ref", "search_trace_ref"]
      }
    }
  ]
}
