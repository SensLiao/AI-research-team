{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/experiment_feedback.schema.json",
  "title": "Experiment Feedback",
  "description": "ANALYZE-stage failure-attribution artifact. Separates hypothesis, implementation, environment, data, evaluation, protocol, statistics, inconclusive, and unknown explanations. The attribution state and validity flags prevent runtime or protocol failures from masquerading as hypothesis falsification. Advisory evidence only; never an automatic scientific decision.",
  "type": "object",
  "required": ["run_ref", "hypothesis_ref", "outcome", "attribution", "summary", "evidence_ref",
    "attribution_state", "counterfactual_check", "replication_status",
    "implementation_valid", "data_valid", "evaluation_valid", "protocol_valid", "statistics_valid"],
  "additionalProperties": false,
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "required": ["artifact_ref", "sha256"],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "run_ref": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "The run/artifact this feedback is about (run_record or result_summary ref)."},
    "hypothesis_ref": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Required stable reference to the exact hypothesis this feedback attributes."},
    "outcome": {"type": "string", "enum": ["improved", "regressed", "inconclusive", "failed"]},
    "attribution": {"type": "string", "enum": ["hypothesis", "implementation", "environment", "data", "evaluation", "protocol", "statistics", "inconclusive", "unknown"]},
    "attribution_state": {"type": "string", "enum": ["symptom_only", "associated", "reproduced", "intervention_confirmed", "counterfactually_supported"]},
    "counterfactual_check": {"type": "string", "enum": ["not_tested", "supports", "does_not_support", "inconclusive"]},
    "replication_status": {"type": "string", "enum": ["not_attempted", "failed_to_reproduce", "reproduced_once", "replicated"]},
    "implementation_valid": {"type": "boolean"},
    "data_valid": {"type": "boolean"},
    "evaluation_valid": {"type": "boolean"},
    "protocol_valid": {"type": "boolean"},
    "statistics_valid": {"type": "boolean"},
    "diagnostic_intervention": {
      "$ref": "#/$defs/artifactBinding",
      "description": "Receipt-bound diagnostic intervention result. Required for intervention_confirmed and counterfactually_supported states."
    },
    "replication_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactBinding"},
      "description": "Receipt-bound independent replication results."
    },
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "next_action_hint": {"type": "string", "enum": ["revise_hypothesis", "fix_implementation", "fix_environment", "fix_data", "fix_evaluation", "fix_protocol", "increase_precision", "run_diagnostic", "escalate", "stop"], "description": "Advisory routing hint for the bounded-repair loop / next design. NEVER auto-executed at a director gate."},
    "metrics_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "before": {"type": ["number", "null"], "default": null},
          "after": {"type": ["number", "null"], "default": null}
        }
      }
    },
    "evidence_ref": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "description": "Anti-slop: the artifacts (result_summary / journal entries / receipt-bound diagnostics) this attribution is derived from."}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attribution_state": {
            "enum": ["intervention_confirmed", "counterfactually_supported"]
          }
        }
      },
      "then": {"required": ["diagnostic_intervention", "replication_artifacts"]}
    },
    {
      "if": {"properties": {"attribution": {"const": "hypothesis"}}},
      "then": {"required": ["diagnostic_intervention", "replication_artifacts"]}
    },
    {
      "if": {
        "properties": {
          "replication_status": {
            "enum": ["failed_to_reproduce", "reproduced_once", "replicated"]
          }
        }
      },
      "then": {"required": ["replication_artifacts"]}
    }
  ]
}
