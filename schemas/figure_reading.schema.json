{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/figure_reading.schema.json",
  "title": "Figure Reading",
  "description": "Structured visual reading of a paper. Text or captions alone never count as visual inspection: inspected items point to a hash-verified page render; otherwise visual_input_status/inspection_status must be UNREAD_VISUAL.",
  "type": "object",
  "required": ["source_ref", "figures"],
  "additionalProperties": false,
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "description": "The paper these figures come from."
    },
    "visual_input_status": {
      "type": "string",
      "enum": ["INSPECTED_VISUAL", "UNREAD_VISUAL", "NOT_APPLICABLE"],
      "description": "INSPECTED_VISUAL only when actual page-render assets were opened."
    },
    "visual_manifest_ref": {
      "type": ["string", "null"],
      "default": null,
      "description": "Run-relative path to inbox/paper-visual-manifest.json."
    },
    "figures": {
      "type": "array",
      "description": "One entry per figure or table selected for close reading.",
      "items": {
        "type": "object",
        "required": ["figure_ref", "take_home"],
        "additionalProperties": false,
        "properties": {
          "figure_ref": {
            "type": "string",
            "description": "Human-readable label such as Figure 3 or Table 4."
          },
          "inspection_status": {
            "type": "string",
            "enum": ["INSPECTED_VISUAL", "UNREAD_VISUAL", "NOT_APPLICABLE"]
          },
          "page": {
            "type": ["integer", "null"],
            "minimum": 1,
            "default": null
          },
          "visual_asset_ref": {
            "type": ["string", "null"],
            "default": null,
            "description": "Run-relative PNG/JPG path actually inspected."
          },
          "visual_asset_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$",
            "default": null
          },
          "axes": {
            "type": "string",
            "description": "What the axes, rows, or columns actually measure."
          },
          "controls": {
            "type": ["string", "null"],
            "default": null
          },
          "error_bars": {
            "type": ["string", "null"],
            "default": null
          },
          "take_home": {
            "type": "string",
            "description": "The narrow conclusion supported by this visual."
          },
          "distrust": {
            "type": ["string", "null"],
            "default": null
          }
        }
      }
    }
  }
}
