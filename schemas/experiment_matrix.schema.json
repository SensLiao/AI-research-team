{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/experiment_matrix.schema.json",
  "title": "Experiment Matrix",
  "description": "DESIGN-stage exit artifact. Output of experiment-planner: the conditions x factors grid, the studied/controlled/frozen variable declaration, a ranked batch of next runs, and a written leakage declaration. PROPOSAL only — designing is not launching.",
  "type": "object",
  "required": ["research_question", "variables", "conditions", "ranked_batch", "leakage_declaration"],
  "additionalProperties": false,
  "properties": {
    "research_question": {"type": "string", "minLength": 1},
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studied", "controlled", "frozen"],
      "properties": {
        "studied": {"type": "array", "items": {"type": "string"}},
        "controlled": {"type": "array", "items": {"type": "string"}},
        "frozen": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "factors"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "factors": {"type": "object"},
          "baseline": {"type": "boolean", "default": false}
        }
      }
    },
    "ranked_batch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "condition_id", "hypothesis"],
        "additionalProperties": false,
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "condition_id": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "cost_gpu_hours": {"type": ["number", "null"], "minimum": 0, "default": null},
          "expected_signal": {"type": "string"}
        }
      }
    },
    "leakage_declaration": {"type": "string", "minLength": 1}
  }
}
