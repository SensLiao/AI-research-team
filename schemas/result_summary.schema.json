{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/result_summary.schema.json",
  "title": "Result Summary",
  "description": "ANALYZE-stage exit artifact. Output of result-analyzer. Summarizes run findings vs baselines. Hard ceiling enforced in-schema: status is always 'provisional' and can_cite_thesis is always false — the analyzer never self-freezes; freezing requires the adversarial-reviewer gate plus a human.",
  "type": "object",
  "required": ["status", "findings", "can_cite_thesis"],
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "const": "provisional"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "condition_id"],
        "additionalProperties": false,
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "condition_id": {"type": "string", "minLength": 1},
          "baseline_value": {"type": ["number", "null"], "default": null},
          "delta": {"type": ["number", "null"], "default": null}
        }
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}, "default": []},
    "can_cite_thesis": {"type": "boolean", "const": false}
  }
}
