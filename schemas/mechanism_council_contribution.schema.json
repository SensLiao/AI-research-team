{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os/schemas/mechanism_council_contribution.schema.json",
  "title": "Mechanism Council Contribution",
  "type": "object",
  "required": [
    "contract_version",
    "role",
    "input_sha256",
    "status",
    "perspective_summary",
    "observations",
    "proposed_mechanisms",
    "experiments",
    "blockers"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "mechanism-council-contribution/v1"},
    "role": {
      "enum": [
        "mathematical_formalizer",
        "domain_reality_auditor",
        "cognitive_intent_modeler",
        "curriculum_design_specialist",
        "research_engineering_planner",
        "causal_mechanism_critic"
      ]
    },
    "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["COMPLETE", "BLOCKED"]},
    "perspective_summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["observation_id", "kind", "statement", "evidence_status", "source_refs"],
        "additionalProperties": false,
        "properties": {
          "observation_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "kind": {"enum": ["support", "risk", "assumption", "confound", "requirement"]},
          "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_status": {"enum": ["VERIFIED", "UNVERIFIED", "CONTRADICTED"]},
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_status": {"const": "VERIFIED"}}},
            "then": {"properties": {"source_refs": {"minItems": 1}}}
          }
        ]
      }
    },
    "proposed_mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mechanism_id", "description", "inputs", "transformation", "expected_signal", "failure_mode"],
        "additionalProperties": false,
        "properties": {
          "mechanism_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "transformation": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "expected_signal": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "failure_mode": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experiment_id", "comparison", "held_constant", "observable", "falsifier"],
        "additionalProperties": false,
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "comparison": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "held_constant": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "observable": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "falsifier": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}

